{
  "name": "@fiaro-app/contracts",
  "version": "0.0.0",
  "description": "Schemas de Zod compartidos entre api, web y mobile",
  "author": "Alejo Zuleta <valenciazuletaj@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/fiaro-app/contracts#readme",
  "bugs": {
    "url": "https://github.com/fiaro-app/contracts/issues"
  },
  "keywords": [
    "fiaro",
    "zod",
    "schemas",
    "contracts",
    "shared"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "docs": "typedoc --out docs src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiaro-app/contracts.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@11.11.0",
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
